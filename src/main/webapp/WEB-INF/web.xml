<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>SmartRail AI</display-name>
    <description>Intelligent Railway Traffic Monitoring and Control System - Tamil Nadu Zone</description>

    <!-- Welcome File -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Security & Authentication Filter -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.smartrail.servlet.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Authentication Servlet -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.smartrail.servlet.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/auth</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/api/auth</url-pattern>
    </servlet-mapping>

    <!-- Core Servlets -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.smartrail.servlet.DashboardServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApiDivisionServlet</servlet-name>
        <servlet-class>com.smartrail.servlet.ApiDivisionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiDivisionServlet</servlet-name>
        <url-pattern>/api/divisions</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApiStationServlet</servlet-name>
        <servlet-class>com.smartrail.servlet.ApiStationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiStationServlet</servlet-name>
        <url-pattern>/api/stations</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApiTrackServlet</servlet-name>
        <servlet-class>com.smartrail.servlet.ApiTrackServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiTrackServlet</servlet-name>
        <url-pattern>/api/tracks</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApiTrainServlet</servlet-name>
        <servlet-class>com.smartrail.servlet.ApiTrainServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiTrainServlet</servlet-name>
        <url-pattern>/api/trains</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApiSimulationServlet</servlet-name>
        <servlet-class>com.smartrail.servlet.ApiSimulationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiSimulationServlet</servlet-name>
        <url-pattern>/api/simulation</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApiConflictServlet</servlet-name>
        <servlet-class>com.smartrail.servlet.ApiConflictServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiConflictServlet</servlet-name>
        <url-pattern>/api/conflict</url-pattern>
    </servlet-mapping>

    <!-- Phase 3 Advanced Servlets: Analytics, Schedules, Alert History, Movements -->
    <servlet>
        <servlet-name>ApiAnalyticsServlet</servlet-name>
        <servlet-class>com.smartrail.servlet.ApiAnalyticsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiAnalyticsServlet</servlet-name>
        <url-pattern>/api/analytics</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApiScheduleServlet</servlet-name>
        <servlet-class>com.smartrail.servlet.ApiScheduleServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiScheduleServlet</servlet-name>
        <url-pattern>/api/schedules</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApiAlertHistoryServlet</servlet-name>
        <servlet-class>com.smartrail.servlet.ApiAlertHistoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiAlertHistoryServlet</servlet-name>
        <url-pattern>/api/alert-history</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApiMovementServlet</servlet-name>
        <servlet-class>com.smartrail.servlet.ApiMovementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiMovementServlet</servlet-name>
        <url-pattern>/api/movements</url-pattern>
    </servlet-mapping>

    <!-- Session Configuration -->
    <session-config>
        <session-timeout>60</session-timeout>
    </session-config>

</web-app>
